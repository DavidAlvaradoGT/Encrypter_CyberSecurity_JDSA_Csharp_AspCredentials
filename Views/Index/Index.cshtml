@model Encrypter_JDSA.Models.UserCredentialPageModel
@{
    ViewBag.Title = "Encrypter DAVID User Credentials Encrypted Code to DataBase";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <style>
        :root {
            --bg-main: black;
            --bg-card: BLACK;
            --bg-input: #00938d;
            --bg-hover: #16D161;
            --border-subtle: #161616;
            --accent: #40E0D0
            --accent-dim: rgba(0, 229, 168, 0.12);
            --accent-secondary: #38bdf8;
            --text-main: #eef2f7;
            --text-muted: #94a3b8;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 32px 20px;
            background-color: var(--bg-main);
            background-image: radial-gradient(circle at top right, rgba(56, 189, 248, 0.08), transparent 40%), radial-gradient(circle at top left, rgba(0, 229, 168, 0.08), transparent 45%);
            color: var(--text-main);
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
            line-height: 1.5;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
        }

        .header-box {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-left: 4px solid var(--accent);
            border-radius: 10px;
            padding: 20px 24px;
            margin-bottom: 24px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
        }

        .header-top {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        h1 {
            margin: 0;
            font-size: 1.75rem;
            letter-spacing: 0.5px;
            color: var(--accent);
        }

        .badge-sync {
            font-size: 0.85rem;
            color: var(--accent-secondary);
            background: rgba(56, 189, 248, 0.1);
            border: 1px solid rgba(56, 189, 248, 0.25);
            padding: 6px 12px;
            border-radius: 999px;
        }

        .dialog-banner {
            margin-top: 14px;
            padding: 12px 16px;
            background: var(--accent-dim);
            border: 1px dashed rgba(0, 229, 168, 0.45);
            border-radius: 8px;
            color: var(--text-main);
            font-size: 0.95rem;
        }

            .dialog-banner strong {
                color: var(--accent);
            }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 10px;
            padding: 22px 24px;
            margin-bottom: 24px;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
        }

        h2, h3 {
            margin-top: 0;
            margin-bottom: 16px;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            align-items: end;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        .form-group input {
            width: 100%;
            padding: 10px 12px;
            background: var(--bg-input);
            border: 1px solid var(--border-subtle);
            border-radius: 7px;
            color: var(--text-main);
            font-size: 0.95rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .form-group input:focus {
                outline: none;
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(0, 229, 168, 0.16);
            }

        .btn-submit {
            padding: 11px 20px;
            background: var(--accent);
            color: #06100d;
            border: none;
            border-radius: 7px;
            font-weight: 700;
            font-size: 0.92rem;
            cursor: pointer;
            transition: transform 0.12s, filter 0.15s;
        }

            .btn-submit:hover {
                filter: brightness(1.08);
                transform: translateY(-1px);
            }

            .btn-submit:active {
                transform: translateY(0);
            }

        .table-wrap {
            overflow-x: auto;
            border-radius: 8px;
            border: 1px solid var(--border-subtle);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.86rem;
        }

        th, td {
            padding: 10px 12px;
            text-align: left;
            border-bottom: 1px solid var(--border-subtle);
            white-space: nowrap;
        }

        th {
            background: #0d121a;
            color: var(--accent-secondary);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.6px;
        }

        tbody tr:hover {
            background: var(--bg-hover);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .token-cell {
            font-family: Consolas, "Courier New", monospace;
            font-size: 0.8rem;
            color: #a7f3d0;
            max-width: 240px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .plain-cell {
            font-family: Consolas, "Courier New", monospace;
            font-size: 0.82rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-box">
            <div class="header-top">
                <h1>Encrypter</h1>
                <span class="badge-sync">User Creation Date / Encryption: @Model.NetworkDateUsed</span>
            </div>
            <div class="dialog-banner">
                <strong>Description:</strong> User Credentials Encrypted Code to DataBase
            </div>
        </div>

        <div class="card">
            <h2>Save UserName &amp; Password - Credentials Security</h2>
            @using (Html.BeginForm("Index", "Index", FormMethod.Post))
            {
                <div class="form-grid">
                    <div class="form-group">
                        <label for="UserNameInput">UserName</label>
                        <input id="UserNameInput" type="text" name="UserNameInput" value="@Model.UserNameInput" required />
                    </div>
                    <div class="form-group">
                        <label for="PasswordInput">Password</label>
                        <input id="PasswordInput" type="password" name="PasswordInput" value="@Model.PasswordInput" required />
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn-submit">Create User</button>
                    </div>
                </div>
            }
        </div>

        <div class="card">
            <h3>Database Users Credentials (Users)</h3>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>UserName</th>
                            <th>Password</th>
                            <th>EncryptedPassword</th>
                            <th>EncryptedUserName</th>
                            <th>DecryptUserName</th>
                            <th>DecryptPassword</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Users)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="plain-cell">@item.UserName</td>
                                <td class="plain-cell">@item.Password</td>
                                <td class="token-cell" title="@item.EncryptedPassword">@item.EncryptedPassword</td>
                                <td class="token-cell" title="@item.EncryptedUserName">@item.EncryptedUserName</td>
                                <td class="plain-cell">@item.DecryptedUserName</td>
                                <td class="plain-cell">@item.DecryptedPassword</td>
                                <td>@item.UserDateCreation</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>